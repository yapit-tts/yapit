#!/bin/bash
set -euo pipefail

if ! command -v duckdb &>/dev/null; then
    ARCH=$(dpkg --print-architecture)  # amd64 or arm64, the names DuckDB's release assets use
    mkdir -p "$HOME/.local/bin"
    curl -fsSL "https://github.com/duckdb/duckdb/releases/latest/download/duckdb-cli-linux-${ARCH}.tar.gz" \
        | tar -xz -C "$HOME/.local/bin" duckdb
fi
