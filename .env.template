# .env.sops structure template
# Decrypt with: make dev-env (for dev) or make prod-env (for prod)
#
# Convention:
#   DEV_*     → copied only by `make dev-env`, prefix stripped
#   PROD_*    → copied only by `make prod-env`, prefix stripped
#   _*        → never copied (reference/inactive)
#   no prefix → copied to both dev and prod as-is

# Postgres
PROD_DATABASE_URL=postgresql+asyncpg://yapit_prod:PASSWORD@postgres:5432/yapit_prod
PROD_POSTGRES_PASSWORD=

# Metrics DB
PROD_METRICS_DB_USER=metrics
PROD_METRICS_DB_PASSWORD=
PROD_METRICS_DATABASE_URL=postgresql://metrics:PASSWORD@metrics-db:5432/metrics

# Auth emails from the gateway (prod only)
PROD_SMTP_HOST=
PROD_SMTP_PORT=
PROD_SMTP_USERNAME=
PROD_SMTP_PASSWORD=
PROD_SMTP_SENDER=

# Google and GitHub sign-in: one OAuth app per environment, redirect URI {APP_URL}/api/v1/auth/oauth/{google,github}/callback
DEV_GOOGLE_CLIENT_ID=
DEV_GOOGLE_CLIENT_SECRET=
DEV_GITHUB_CLIENT_ID=
DEV_GITHUB_CLIENT_SECRET=
PROD_GOOGLE_CLIENT_ID=
PROD_GOOGLE_CLIENT_SECRET=
PROD_GITHUB_CLIENT_ID=
PROD_GITHUB_CLIENT_SECRET=

# API Keys
DEV_GOOGLE_API_KEY=
PROD_GOOGLE_API_KEY=

ANONYMOUS_SESSION_SECRET=

# Stripe
# Webhook secret: run `docker logs yapit-stripe-cli-1` to get the signing secret
# (It's stable per Stripe account, only changes if you change the API key)
DEV_STRIPE_SECRET_KEY=
DEV_STRIPE_WEBHOOK_SECRET=
PROD_STRIPE_SECRET_KEY=
PROD_STRIPE_WEBHOOK_SECRET=

# Monitoring / Notifications
CLOUDFLARE_API_TOKEN=
# Failure-alert email channel for scripts/sync-cf-firewall.sh, whose cron on
# the VPS reads them from /opt/yapit/.env.firewall. Values mirror the dotfiles
# secrets/monitoring/alert.conf; leave empty everywhere else — laptop-side
# scripts alert through the dotfiles bin/alert-send instead.
ALERT_SMTP_URL=
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_MAIL_FROM=
ALERT_MAIL_TO=

