FROM stackauth/server:53c1c9e

USER root

RUN \
    mkdir -p /var/lib/apt/lists/partial && \
    rm -rf /var/lib/apt/lists/* && \
    apt-get clean && \
    apt-get update && \
    apt-get install -y curl && \
    rm -rf /var/lib/apt/lists/*

# Restore base image user
USER node

# GitHub's OAuth callback now carries iss=https://github.com/login/oauth (RFC 9207), which
# this build rejects as an issuer mismatch. Upstream fixed it in 030196133 (April 2026);
# drop this once the pinned image includes that commit.
RUN files=$(grep -rlF 'issuer:"https://github.com"' /app/apps/backend/.next/server) && \
    [ "$(echo "$files" | wc -l)" -eq 1 ] && \
    sed -i 's|issuer:"https://github.com"|issuer:"https://github.com/login/oauth"|' $files && \
    grep -qF 'issuer:"https://github.com/login/oauth"' $files
